# pgauthz compose deployment — copy to .env and edit. Required values are marked;
# the compose file refuses to start without them. Keep .env out of version
# control; prefer a secret manager that writes it at deploy time.

# ── Images ───────────────────────────────────────────────────────────────────
# Tag of the pgauthz images (pgauthz-pgauthzd, pgauthz-migrations). `docker
# compose build` builds them from this checkout; or tag images from your
# registry with PGAUTHZ_IMAGE_PREFIX (e.g. registry.example.com/pgauthz).
PGAUTHZ_VERSION=0.17.0
#PGAUTHZ_IMAGE_PREFIX=pgauthz
#POSTGRES_TAG=18.6

# ── Passwords (REQUIRED) ─────────────────────────────────────────────────────
PG_PASSWORD=                     # the authz superuser (install identity, administration)
AUTHZEN_DIRECT_PASSWORD=         # read-only login of pgauthzd-decision (and pgauthzd-opa)
PGAUTHZD_RW_PASSWORD=            # writer login of pgauthzd-full
# Applied by `migrate` on every `up`: change a value here and `up` again to rotate.

# ── JWT verification (REQUIRED) ──────────────────────────────────────────────
JWT_ISSUER=https://idp.example.com/realms/example
JWT_AUDIENCE=authz-api           # this API's identifier in the token's `aud`
JWKS_URL=https://idp.example.com/realms/example/protocol/openid-connect/certs
#JWKS_FILE=/jwks/jwks.json       # alternative: mount a file into the pgauthzd services
# Where the caller's roles are (comma-separated dotted paths; Keycloak:
# realm_access.roles,resource_access.authz-api.roles). WRITER_ROLE within them
# authorizes writes on pgauthzd-full; RECORDER_ROLE the action log.
JWT_ROLES_CLAIM=roles
WRITER_ROLE=authz_writer
RECORDER_ROLE=authz_recorder

# ── Surface ──────────────────────────────────────────────────────────────────
# Bind address + host port of each instance. Loopback by default — put a TLS
# terminating reverse proxy in front (then TRUST_FORWARDED_HEADERS=true or
# BASE_URL=https://authz.example.com so discovery advertises the right base).
READ_BIND=127.0.0.1
READ_PORT=8080
WRITE_BIND=127.0.0.1
WRITE_PORT=8082
#TRUST_FORWARDED_HEADERS=true
#BASE_URL=https://authz.example.com
DEFAULT_STORE=demo
#CORS_ALLOWED_ORIGINS=

# ── Production profile ───────────────────────────────────────────────────────
# The diagnostic surfaces are role-gated; pgauthzd refuses to start otherwise.
DEPLOYMENT_ENVIRONMENT=production
SEARCH_REQUIRED_ROLE=authz_auditor
EXPLAIN_REQUIRED_ROLE=authz_auditor
#WATCH_REQUIRED_ROLE=authz_auditor   # unset = the changefeed endpoint is disabled

# ── Engine knobs ─────────────────────────────────────────────────────────────
CONDITION_STATEMENT_TIMEOUT=60s    # statement_timeout of the service roles
#PG_MAX_CONNECTIONS=250
#PG_SHARED_BUFFERS=256MB
#PG_EFFECTIVE_CACHE_SIZE=768MB
#PG_WORK_MEM=16MB
#PG_IDLE_IN_TXN_TIMEOUT=60s
#READ_POOL_MAX=25
#WRITE_POOL_MAX=10
#FRESHNESS_TOKEN_KEYS=            # same list on every instance (ADR 0009)

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
DECISION_LOG=off                   # off | stdout | stderr | file:<path> | postgres  (ADR 0013 / 0015)
#DECISION_LOG_DSN=postgres://console:<pw>@console-db:5432/pgauthz_console   # postgres sink: the console's DB → Decisions tab
#DECISION_LOG_RETENTION_DAYS=30
#OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318   # OpenTelemetry traces (OTLP); unset = propagation only
#OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf                # or grpc
#PUBLIC_HEALTH_ENABLED=true         # false: /livez /readyz /healthz on the management listener (:9090) only, not on the client port
#ISSUERS_SOURCE=env                 # env | env+db (issuer bindings from authz.issuer_bindings, console-managed)
#ISSUERS_POLL_INTERVAL=30
#ISSUERS_REQUIRED_ROLE=authz_auditor  # who may read GET /pgauthz/v1/issuers on the public listener
# The admin API on pgauthzd-full (/pgauthz/v1/admin/…: issuer bindings; the
# configuration-as-code surface). Off by default. Enabled, it needs a gate — a
# per-issuer `admin` binding in JWT_ISSUERS ({"admin":{"scopes":[…],"claims":{…},
# "clients":[…],"scope":"issuer|platform"}}) or ADMIN_ROLE — and management
# runs on its own pool as pgauthzd_admin (authz_admin tier).
#ADMIN_API_ENABLED=false
#ADMIN_LISTEN_ADDR=:8082             # its own listener; expose it to management clients only
#ADMIN_ROLE=pgauthz_admin            # single-issuer shorthand: a role the token must hold (platform scope)
#PGAUTHZD_ADMIN_PASSWORD=            # set by the migrate service, like PGAUTHZD_RW_PASSWORD
#ADMIN_DATABASE_URL=postgres://pgauthzd_admin:<PGAUTHZD_ADMIN_PASSWORD>@db:5432/authz
#TRACING=auto                       # auto (on when an endpoint is set) | on (propagation even without one) | off
#TRACING_IDENTIFIERS=false          # subject/resource IDS on spans; default types only (the decision log keeps the ids)
#DECISION_LOG_SAMPLE=1
#DECISION_LOG_DETAIL=false
#DECISION_LOG_REQUIRED=false
#DECISION_LOG_SEARCHES=false

# ── Derived relations (`--profile derived`) ──────────────────────────────────
# A precomputed table other databases subscribe to (docs/DESIGN.md →
# Integration patterns). Enable the install, the worker's password, and the
# stores to register at the worker's first start.
#DERIVED_RELATIONS=1
#DERIVED_WORKER_PASSWORD=
#DERIVED_STORES=demo
#WORKER_LAG=1 second
#WORKER_INTERVAL=2
# Publication for subscribers (compose.logical.yml):
#REPLICATOR_PASSWORD=
#DB_BIND=0.0.0.0
#DB_PORT=5432

# ── Management console (`--profile console`) ─────────────────────────────────
# console/README.md. Served at BASE_URL/console (set BASE_URL above); register a
# confidential OIDC client with redirect URI <BASE_URL>/console/auth/callback.
#CONSOLE_ISSUER=https://idp.example.com/realms/example
#CONSOLE_CLIENT_ID=console-bff
#CONSOLE_CLIENT_SECRET=
#CONSOLE_PROVIDER_LABEL=           # the sign-in button; empty = the issuer's host
#CONSOLE_AUTO_LOGIN=               # true: skip the sign-in page, straight to the provider
#CONSOLE_OUTBOUND_HOSTS=           # IdP hosts the console may discover (*.idp.example); the platform's always
#GROUP_ISSUER_HOSTS=               # IdP hosts tenants may bring as group issuers (pgauthzd fetches their keys)
# Behind a dedicated egress proxy that enforces the policy: =proxy on both and
# set HTTPS_PROXY / NO_PROXY for the containers; the in-app host checks are then off.
#OUTBOUND_HOST_POLICY=allowlist    # pgauthzd: allowlist | proxy | off
#CONSOLE_OUTBOUND_HOST_POLICY=allowlist
# Without an IdP (a first look, tests): the local admin sign-in. Set both to
# enable; remove them and `up` again to deactivate (every local session ends).
# Refused with DEPLOYMENT_ENVIRONMENT=production unless the override is set.
#CONSOLE_LOCAL_ADMIN_USER=admin
#CONSOLE_LOCAL_ADMIN_PASSWORD=
#CONSOLE_LOCAL_ADMIN_TEAMS=role_console_admin
#CONSOLE_LOCAL_ADMIN_STORE_ROLE=owner   # on every store, contextually; "none" = teams only
#CONSOLE_LOCAL_ADMIN_ALLOW_IN_PRODUCTION=false
#CONSOLE_ENGINE_PASSWORD=          # authz_console, the BFF's engine login
#CONSOLE_SESSIONS_DB=pgauthz_console   # created in this instance, owner role `console`
#CONSOLE_SESSIONS_PASSWORD=
#CONSOLE_STORE_INIT=1              # create the console's own store once (examples/models/console)
#CONSOLE_STORE=console
#CONSOLE_BIND=127.0.0.1
#CONSOLE_PORT=8083
#CONSOLE_COOKIE_SECURE=true
#CONSOLE_TLS_CA_FILE=              # e.g. /etc/pgauthz/ca.crt (mount it) for a private issuer CA
#CONSOLE_SELF_SUBJECT_TYPES=user
#CONSOLE_TEAM_CLAIMS=role=realm_access.roles,group=groups,org=organization
#CONSOLE_DECISION_URL=http://pgauthzd-decision:8080   # http://pgauthzd-opa:8080 with the opa profile
#CONSOLE_OPA_URL=                  # http://opa:8181 with the opa profile (Policies tab)
# Platform → Issuers reads the issuer set in force over pgauthzd-full's callback
# listener with NATIVE_SERVICE_TOKEN (set once, above); nothing else to set.

# ── OPA policy-as-code (`--profile opa`) ─────────────────────────────────────
#OPA_ADMIN_TOKEN=
#NATIVE_SERVICE_TOKEN=            # shared secret between OPA and the pgauthzd callbacks
#OPA_GATEWAY_BIND=127.0.0.1
#OPA_GATEWAY_PORT=8081
#DEFAULT_CACHE_TTL_SECONDS=1
